{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yesplaymusic-landing",
  "compatibility_date": "2026-11-01",
  // Static site plus a tiny Worker that only redirects / to /zh/ or /en/ by language
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "routes": [{ "pattern": "yesplaymusic.0xtangerine.com", "custom_domain": true }]
}
